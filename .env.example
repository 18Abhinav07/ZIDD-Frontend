# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials).
# GOOGLE_CLIENT_SECRET is server-only — never prefix with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret

# Backend URL reachable from the Next.js server runtime.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Set to 1 to hide credit, wallet, paywall, pack-purchase, and checkout UI.
NEXT_PUBLIC_BETA_BILLING_DISABLED=0

# Use only with the local Qwen backend. Gemini and cloud-backed School runs keep
# bounded request deadlines by default, including on localhost.
NEXT_PUBLIC_SCHOOL_QWEN_UNBOUNDED=0
