{
  "name": "zidd-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:school-prep": "BACKEND_INTERNAL_URL=http://127.0.0.1:8088 NEXTAUTH_URL=http://localhost:3001 NEXT_PUBLIC_SCHOOL_LOCAL_MODE=1 NEXT_DIST_DIR=.next-schoolprep-3001 next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:no-local-storage": "node scripts/check-no-product-local-storage.mjs",
    "test:auth-middleware": "node scripts/check-auth-middleware.mjs",
    "test:auth-flow": "node scripts/check-auth-flow.mjs",
    "test:app-shell": "node scripts/check-app-shell-routing.mjs",
    "test:session-proxy": "node scripts/check-session-proxy.mjs",
    "test:session-start-idempotency": "node scripts/check-session-start-idempotency.mjs",
    "test:session-stream-guards": "node scripts/check-session-stream-guards.mjs",
    "test:assessment-action-contract": "node scripts/check-assessment-action-contract.mjs",
    "test:school-rebuild-surface": "node scripts/check-school-rebuild-surface.mjs",
    "test:school-activity-policy": "node --experimental-strip-types --test tests/schoolActivityPolicy.test.ts",
    "test:school-onboarding-policy": "node --experimental-strip-types --test tests/schoolOnboardingPolicy.test.ts",
    "test:school-visual-identity": "node --experimental-strip-types --test tests/schoolVisualIdentity.test.ts",
    "test:school-backend-contract": "node --test tests/schoolBackendContract.test.mjs",
    "test:school-trace-sanitizer": "node --test tests/sanitizeSchoolTraces.test.mjs tests/runSchoolBrowser.test.mjs tests/schoolBrowserArchitecture.test.mjs",
    "test:school-browser": "node scripts/run-school-browser.mjs",
    "test:school-phase-b-browser": "node scripts/run-school-browser.mjs --config=playwright.school-phase-b.config.ts",
    "test:simulator-runtime-safety": "node scripts/check-simulator-runtime-safety.mjs",
    "test:tutor-shell-avatar": "node scripts/check-tutor-shell-avatar.mjs",
    "test:ux-edge-hardening": "node scripts/check-ux-edge-hardening.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@studio-freight/react-lenis": "^0.0.47",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.2",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.15",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
